HOWCANVAS_PORT=3000
NODE_ENV=production
PORT=8787

# Replace both values before the first start.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Set to true only after HTTPS is configured in front of port 3000.
COOKIE_SECURE=false
ALLOW_REGISTRATION=false
CORS_ORIGINS=

# Optional analytics IDs. Leave empty to disable analytics.
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
